# Optional Docker font mount. Copy to .env for local use.
# Windows default:
MMA_OFFICIAL_FONTS_DIR=C:\Windows\Fonts

# Trusted single-user Docker only. Uncomment this line to make plain
# `docker compose` commands load the hardened local-execution overlay. Keep it
# enabled on a workstation that has no E2B; use the guarded script action
# `UseRemote` only after E2B_API_KEY is configured.
# COMPOSE_FILE=docker-compose.yml;docker-compose.override.yml;docker-compose.local-execution.yml
